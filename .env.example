# Optional user-owned inference. Never enables payment execution.
# This file is a reference; .env is ignored and is not automatically loaded.
LLM_PROVIDER=mock

# Generic OpenAI-compatible provider (hosted or local)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# User-run Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
